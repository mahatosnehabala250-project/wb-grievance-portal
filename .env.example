# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-strong-random-secret-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-dashboard

# Supabase mode — set to this value to use REST API (no direct DB needed)
DATABASE_URL=supabase://use-rest-api
DIRECT_URL=supabase://use-rest-api

# Vercel Token (for deployment API access)
VERCEL_TOKEN=your-vercel-token-here

# n8n Editor — used by /dashboard/agents to deep-link to workflow nodes for prompt editing
NEXT_PUBLIC_N8N_HOST=https://your-n8n-instance.example.com

# Vercel Cron secret — Vercel attaches `Authorization: Bearer ${CRON_SECRET}` to
# scheduled cron invocations (e.g. /api/cron/idempotency-cleanup). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-strong-random-secret-here

# WhatsApp Cloud API — used by the outbox drainer cron
# (/api/cron/whatsapp-outbox-drainer) to send buffered outbound messages.
# Same credentials the n8n workflows use for the Graph API `messages` endpoint.
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
# Optional: max rows the outbox drainer claims per tick (default 100).
OUTBOX_DRAIN_LIMIT=100

# ── Phase 1: Government-ready (P0 security + DPDP) ───────────────────────────
# n8n internal webhook secret — shared HMAC for all /api/* routes the WhatsApp
# agent calls (consent, privacy/erase, guardrail/apply, etc.).
N8N_WEBHOOK_SECRET=generate-a-strong-random-secret-here

# WhatsApp webhook signature verification (Meta App Secret + verify token).
# WHATSAPP_APP_SECRET enables HMAC verification in /api/webhook/whatsapp-verify.
# WHATSAPP_VERIFY_TOKEN is the token you set in the Meta webhook config (GET handshake).
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# DPDP data retention window (days) for /api/cron/data-retention.
# Stale conversation sessions older than this have their PII + memory scrubbed.
# Complaints are NOT auto-erased (legal record); only on explicit erasure.
RETENTION_DAYS=365

# Shared secret for n8n JS-21 daily-brief cron (must match the x-cron-secret header in n8n)
CRON_SECRET=change-me-strong-random

# Telegram bot username (without @) for staff Connect-Telegram deep link in Settings
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# NLP Brain (Level 4) — Anthropic Claude for complaint text analysis
# Get a key at console.anthropic.com. Haiku is cost-right for per-complaint scale.
ANTHROPIC_API_KEY=
# Model override (default claude-haiku-4-5). Use claude-opus-4-8 / claude-sonnet-4-6 for higher quality at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5
