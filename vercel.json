{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/idempotency-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/classifier-calibration",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/whatsapp-outbox-drainer",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 4 * * *"
    }
  ]
}
